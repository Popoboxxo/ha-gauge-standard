{
  "canon_version": "1.0.0",
  "stand": "2026-10-04",
  "master": {
    "repo": "Popoboxxo/ha-go-gauge",
    "domain": "go_gauge",
    "version": "1.5.2"
  },
  "convergence_target": {
    "repo": "Popoboxxo/ha-command-gauge",
    "domain": "command_gauge",
    "version": "0.2.0"
  },
  "naming": {
    "window_position": "prefix",
    "pattern_windowed": "{window} <Concept>",
    "example_windowed": "{window} Usage",
    "master_language": "en",
    "strings_master": "strings.json",
    "translation_files": ["strings.json", "translations/en.json", "translations/de.json"],
    "device_name_pattern": "{Brand} {Scope}",
    "no_attr_name_literals": true
  },
  "device": {
    "identifiers": "{DOMAIN}:{entry_id}",
    "manufacturer": "Popoboxxo",
    "model_per_domain": {
      "go_gauge": "OpenCode Go",
      "command_gauge": "CommandCode Cloud"
    },
    "account_device": {
      "go_gauge": "Go Gauge Konto",
      "command_gauge": null
    }
  },
  "windows": {
    "order": ["5h", "week", "month"],
    "labels": {
      "5h": "5h rolling",
      "week": "Weekly",
      "month": "Monthly"
    },
    "seconds": {
      "5h": 18000,
      "week": 604800,
      "month": 2592000
    }
  },
  "entities": [
    {
      "id": "usage",
      "platform": "sensor",
      "scope": "window",
      "translation_key": "usage",
      "aliases": {"command_gauge": "window_usage"},
      "name_en": "{window} Usage",
      "unit": "%",
      "device_class": null,
      "state_class": "MEASUREMENT",
      "icons": ["mdi:speedometer", "mdi:shield-off-outline"],
      "unique_id_suffix": "percent",
      "attributes": ["workspace_key", "window", "status", "note", "resets_at_iso"],
      "behavior": "None state on no_subscription/error; status via icon + attributes"
    },
    {
      "id": "reset",
      "platform": "sensor",
      "scope": "window",
      "translation_key": "reset",
      "aliases": {"command_gauge": "window_reset"},
      "name_en": "{window} Reset",
      "unit": null,
      "device_class": "TIMESTAMP",
      "state_class": null,
      "icons": ["mdi:timer-reset"],
      "unique_id_suffix": "reset",
      "attributes": []
    },
    {
      "id": "forecast",
      "platform": "sensor",
      "scope": "window",
      "translation_key": "forecast",
      "aliases": {"command_gauge": "window_forecast"},
      "name_en": "{window} Forecast",
      "unit": "%",
      "device_class": null,
      "state_class": "MEASUREMENT",
      "icons": ["mdi:trending-up"],
      "unique_id_suffix": "forecast",
      "attributes": [],
      "behavior": "linear projection percent/elapsed_fraction; may exceed 100; None right after reset"
    },
    {
      "id": "pace",
      "platform": "sensor",
      "scope": "window",
      "translation_key": "pace",
      "aliases": {"command_gauge": "window_pace"},
      "name_en": "{window} Pace",
      "unit": null,
      "device_class": null,
      "state_class": null,
      "icons": ["mdi:check-circle-outline", "mdi:alert-circle-outline", "mdi:close-circle-outline", "mdi:speedometer-medium"],
      "unique_id_suffix": "pace",
      "attributes": ["forecast_percent", "green_below", "red_above"],
      "behavior": "green/yellow/red via warning_threshold + pace_red_limit"
    },
    {
      "id": "remaining",
      "platform": "sensor",
      "scope": "window",
      "translation_key": "remaining",
      "aliases": {"command_gauge": "window_remaining"},
      "name_en": "{window} Remaining",
      "unit": "%",
      "device_class": null,
      "state_class": "MEASUREMENT",
      "icons": ["mdi:gauge"],
      "unique_id_suffix": "remaining",
      "attributes": [],
      "behavior": "100 - used; None (never 100) on missing subscription"
    },
    {
      "id": "time_to_reset",
      "platform": "sensor",
      "scope": "window",
      "translation_key": "time_to_reset",
      "aliases": {"command_gauge": "window_time_to_reset"},
      "name_en": "{window} Time to Reset",
      "unit": "h",
      "device_class": "DURATION",
      "state_class": null,
      "icons": ["mdi:timer-sand"],
      "unique_id_suffix": "time_to_reset",
      "attributes": []
    },
    {
      "id": "burn_rate",
      "platform": "sensor",
      "scope": "window",
      "translation_key": "burn_rate",
      "aliases": {"command_gauge": "window_burn_rate"},
      "name_en": "{window} Burn-Rate",
      "unit": "%/h",
      "device_class": null,
      "state_class": "MEASUREMENT",
      "icons": ["mdi:fire"],
      "unique_id_suffix": "burn_rate",
      "attributes": []
    },
    {
      "id": "rate_limited",
      "platform": "binary_sensor",
      "scope": "window",
      "translation_key": "rate_limited",
      "aliases": {"command_gauge": "window_exceeded"},
      "name_en": "{window} rate-limited",
      "device_class": "PROBLEM",
      "icons": ["mdi:block-helper"],
      "unique_id_suffix": "limited",
      "attributes": [],
      "behavior": "ON on window status rate-limited; unavailable (not OFF) on no_subscription/update failure"
    },
    {
      "id": "subscription_active",
      "platform": "binary_sensor",
      "scope": "scope",
      "translation_key": "subscription_active",
      "aliases": {"command_gauge": "subscription_active"},
      "name_en": "Subscription Active",
      "device_class": "CONNECTIVITY",
      "icons": ["mdi:shield-check-outline"],
      "unique_id_suffix": "subscription_active",
      "attributes": ["workspace_key", "note"]
    },
    {
      "id": "api_reachable",
      "platform": "binary_sensor",
      "scope": "account",
      "translation_key": "api_reachable",
      "aliases": {"command_gauge": "account_reachable"},
      "name_en": "API Reachable",
      "device_class": "CONNECTIVITY",
      "icons": [],
      "unique_id_suffix": "api_reachable",
      "attributes": [],
      "behavior": "go_gauge: catalog owner only; command_gauge alias always available"
    },
    {
      "id": "model_catalog",
      "platform": "sensor",
      "scope": "account",
      "translation_key": "model_catalog",
      "aliases": {"command_gauge": "models"},
      "name_en": "Models",
      "unit": null,
      "device_class": null,
      "state_class": "MEASUREMENT",
      "icons": ["mdi:format-list-bulleted"],
      "unique_id_suffix": "model_catalog",
      "attributes": ["models_updated_at", "count", "live_count", "free_models", "cheapest_model", "cheapest_overall", "ranking_by_cost", "catalog_json"],
      "behavior": "ONE sensor carries the whole catalog as dynamic JSON attributes"
    },
    {
      "id": "live_models_count",
      "platform": "sensor",
      "scope": "account",
      "translation_key": "live_models_count",
      "aliases": {},
      "name_en": "Live Models",
      "unit": null,
      "device_class": null,
      "state_class": "MEASUREMENT",
      "icons": ["mdi:check-network-outline"],
      "unique_id_suffix": "models_live_count",
      "attributes": []
    },
    {
      "id": "cheapest_model",
      "platform": "sensor",
      "scope": "account",
      "translation_key": "cheapest_model",
      "aliases": {},
      "name_en": "Cheapest Model",
      "unit": null,
      "device_class": null,
      "state_class": null,
      "icons": ["mdi:crown-outline"],
      "unique_id_suffix": "cheapest_model",
      "attributes": ["cheapest_overall", "ratio_usd_per_1m"]
    },
    {
      "id": "free_models",
      "platform": "sensor",
      "scope": "account",
      "translation_key": "free_models",
      "aliases": {},
      "name_en": "Free Models",
      "unit": null,
      "device_class": null,
      "state_class": null,
      "icons": ["mdi:gift-outline"],
      "unique_id_suffix": "free_models",
      "attributes": []
    },
    {
      "id": "warning_threshold",
      "platform": "number",
      "scope": "entry",
      "translation_key": "warning_threshold",
      "aliases": {"command_gauge": "warn_percent"},
      "name_en": "Warning Threshold",
      "unit": "%",
      "icons": ["mdi:alert-octagon-outline"],
      "unique_id_suffix": "warn_percent",
      "attributes": [],
      "behavior": "NumberMode.BOX, step 1, persistent via persist_options"
    },
    {
      "id": "pace_red_limit",
      "platform": "number",
      "scope": "entry",
      "translation_key": "pace_red_limit",
      "aliases": {"command_gauge": "pace_red_percent"},
      "name_en": "Pace Red Limit",
      "unit": "%",
      "icons": ["mdi:alert-decagram-outline"],
      "unique_id_suffix": "pace_red_percent",
      "attributes": []
    },
    {
      "id": "usage_refresh_min",
      "platform": "number",
      "scope": "entry",
      "translation_key": "usage_refresh_min",
      "aliases": {"command_gauge": "usage_refresh_minutes"},
      "name_en": "Usage Refresh (min)",
      "unit": "min",
      "icons": ["mdi:timer-outline"],
      "unique_id_suffix": "usage_refresh_minutes",
      "attributes": [],
      "behavior": "changing value triggers recalculate_interval()"
    },
    {
      "id": "models_refresh_min",
      "platform": "number",
      "scope": "entry",
      "translation_key": "models_refresh_min",
      "aliases": {"command_gauge": "models_refresh_minutes"},
      "name_en": "Models Refresh (min)",
      "unit": "min",
      "icons": ["mdi:timer-outline"],
      "unique_id_suffix": "models_refresh_minutes",
      "attributes": []
    },
    {
      "id": "auto_update_usage",
      "platform": "switch",
      "scope": "entry",
      "translation_key": "auto_update_usage",
      "aliases": {"command_gauge": "auto_usage"},
      "name_en": "Auto Update Usage",
      "icons": ["mdi:autorenew"],
      "unique_id_suffix": "auto_update_usage",
      "attributes": []
    },
    {
      "id": "auto_update_models",
      "platform": "switch",
      "scope": "entry",
      "translation_key": "auto_update_models",
      "aliases": {"command_gauge": "auto_models"},
      "name_en": "Auto Update Models",
      "icons": ["mdi:autorenew"],
      "unique_id_suffix": "auto_update_models",
      "attributes": []
    },
    {
      "id": "refresh",
      "platform": "button",
      "scope": "entry",
      "translation_key": "refresh",
      "aliases": {"command_gauge": "refresh"},
      "name_en": "Refresh",
      "icons": ["mdi:refresh"],
      "unique_id_suffix": "refresh",
      "attributes": [],
      "behavior": "forces both cycles (usage + models) regardless of auto switches"
    }
  ],
  "domain_extensions": {
    "command_gauge": [
      {"translation_key": "monthly_credits", "platform": "sensor", "unit": "USD", "state_class": "MEASUREMENT", "icon": "mdi:calendar-month", "name_en": "Monthly credits", "reason": "CommandCode credit model (domain-specific, allowed)"},
      {"translation_key": "purchased_credits", "platform": "sensor", "unit": "USD", "state_class": "MEASUREMENT", "icon": "mdi:shopping", "name_en": "Purchased credits", "reason": "dto."},
      {"translation_key": "free_credits", "platform": "sensor", "unit": "USD", "state_class": "MEASUREMENT", "icon": "mdi:gift-outline", "name_en": "Free credits", "reason": "dto."},
      {"translation_key": "remaining_credits", "platform": "sensor", "unit": "USD", "state_class": "MEASUREMENT", "icon": "mdi:wallet", "name_en": "Remaining credits", "reason": "dto."},
      {"translation_key": "total_cost", "platform": "sensor", "unit": "USD", "state_class": "MEASUREMENT", "icon": "mdi:cash", "name_en": "Total cost", "reason": "dto."},
      {"translation_key": "request_count", "platform": "sensor", "unit": null, "state_class": "MEASUREMENT", "icon": "mdi:counter", "name_en": "Requests", "reason": "dto."},
      {"translation_key": "token_count", "platform": "sensor", "unit": null, "state_class": "MEASUREMENT", "icon": "mdi:counter", "name_en": "Tokens", "reason": "dto."},
      {"translation_key": "plan", "platform": "sensor", "unit": null, "state_class": null, "icon": "mdi:shield-account-outline", "name_en": "Plan", "reason": "dto."},
      {"translation_key": "credits_below_threshold", "platform": "binary_sensor", "device_class": "PROBLEM", "icon": null, "name_en": "Credits below threshold", "reason": "dto."}
    ]
  },
  "settings_ranges": {
    "warning_threshold": {"unit": "%", "min": 1, "max": 100, "default": 80, "number": "warning_threshold"},
    "pace_red_limit": {"unit": "%", "min": 1, "max": 300, "default": 100, "number": "pace_red_limit"},
    "usage_refresh_min": {"unit": "min", "min": 1, "max": 1440, "default": 10, "number": "usage_refresh_min"},
    "models_refresh_min": {"unit": "min", "min": 1, "max": 1440, "default": 60, "number": "models_refresh_min"}
  },
