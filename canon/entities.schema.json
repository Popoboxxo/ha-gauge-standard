      {"id": "usage", "aspect": "translation_key", "severity": "warning", "actual": "window_usage", "reason": "Historisch gewachsenes Praefix-Schema", "closing": "Rename auf Kanon-Key im naechsten breaking Release (MAJOR)"},
      {"id": "usage", "aspect": "name_pattern", "severity": "warning", "actual": "Usage {window}", "reason": "Fenster-Placeholder hinten statt vorn", "closing": "mit translation_key-Rename"},
      {"id": "usage", "aspect": "unique_id_suffix", "severity": "warning", "actual": "usage", "reason": "Suffix 'usage' statt 'percent'", "closing": "mit translation_key-Rename (unique_id nie aendern -> Registry-Migration)"},
      {"id": "usage", "aspect": "attributes", "severity": "warning", "actual": [], "reason": "kein no_subscription-Schutz, keine Status-Attribute (API liefert keinen Abo-Status pro Fenster)", "closing": "Abo-Status-Handling angleichen, sobald subscription-Section es hergibt"},
